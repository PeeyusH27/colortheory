{
  "expo": {
    "name": "ColorTheory",
    "slug": "colortheory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "colortheory",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F3EC",
    "ios": {
      "bundleIdentifier": "com.colortheory.app",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.colortheory.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D1626",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1626",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ColorTheory uses the camera to take a portrait for color analysis. Photos are only uploaded if you choose cloud analysis.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ColorTheory lets you choose an existing portrait for color analysis. Photos are only uploaded if you choose cloud analysis.",
          "cameraPermission": "ColorTheory uses the camera to take a portrait for color analysis.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
