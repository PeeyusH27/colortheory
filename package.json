    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
