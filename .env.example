# ColorTheory — website configuration
# Copy to `.env.local` (git-ignored) and fill in. Restart `npm run dev` after edits.
#
# EVERYTHING prefixed NEXT_PUBLIC_ IS INLINED INTO THE BROWSER BUNDLE AND READABLE BY ANYONE.
# Only put values here that are designed to be public. Row Level Security protects the data.
#
# NEVER put these in this file (they belong in Supabase Edge Function secrets):
#   service-role / secret keys (sb_secret_…), ANTHROPIC_API_KEY, FASHN_API_KEY, CLEANUP_SECRET,
#   database passwords, signing keys.
# The site refuses to create its Supabase client if it detects a secret/service-role key here.

# ── Supabase (optional — without it the site runs in in-browser/demo mode) ────────────────────
# Project Settings → API. Use the *publishable* key (sb_publishable_…) on new projects…
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# …or the legacy anon JWT on older projects (used only if the publishable key is empty).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Providers ──────────────────────────────────────────────────────────────────────────────────
# Colour analysis: device (default, private, in the browser) | remote (Edge Function + AI vision) | mock
NEXT_PUBLIC_ANALYSIS_PROVIDER=device
# Outfit previews: mock (default, labelled demo) | remote (Edge Function + FASHN try-on) | off
NEXT_PUBLIC_OUTFIT_GENERATION=mock

# ── Product ────────────────────────────────────────────────────────────────────────────────────
# Offer "Explore in demo mode" on the landing and sign-in pages. Defaults: on without Supabase or
# in development; off in production builds that have Supabase.
NEXT_PUBLIC_ENABLE_DEMO_MODE=
# Links to your published, reviewed legal documents (in-app summaries are shown otherwise).
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=

# ── Shopping links ─────────────────────────────────────────────────────────────────────────────
# Optional affiliate redirect for "Shop this look" links (https, must contain {url}; {retailer} is
# also available), e.g. https://your-network.example/deeplink?id=123&url={url}
# Affiliate ids are public by design. When set, links are marked sponsored and disclosed in the UI.
NEXT_PUBLIC_SHOP_LINK_TEMPLATE=
