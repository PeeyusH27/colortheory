# Edge Function secrets — SERVER ONLY. Never copy these into the app's .env files.
#
# Local:      cp supabase/functions/.env.example supabase/functions/.env
#             npx supabase functions serve --env-file supabase/functions/.env
# Production: npx supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL and the service-role/secret key are injected automatically by Supabase.

# Cloud colour analysis (analyze-portrait) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional overrides
ANALYSIS_MODEL=claude-opus-5-5
ANALYSIS_EFFORT=low
ANALYSIS_DAILY_LIMIT=10

# AI outfit previews (generate-outfit) — https://app.fashn.ai (API key requires purchased credits)
FASHN_API_KEY=
AI_PREVIEW_DAILY_LIMIT=5
# Kill switch for AI previews without redeploying the app.
AI_PREVIEWS_ENABLED=true
# "tryon" (default: true try-on when a garment reference photo exists, else edit) | "edit"
TRYON_MODE=tryon

# Scheduled cleanup (cleanup-orphans). Long random string; also used by the pg_cron job.
CLEANUP_SECRET=
